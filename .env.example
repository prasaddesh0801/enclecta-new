# ---------------------------------------------------------
# Enclecta Ventures — environment variables
# Copy to .env.local for development. Never commit .env.local.
# NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ENV=development

# Contact details shown in the header/footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@enclecta.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000

# Analytics (add when ready)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Server-only secrets (no NEXT_PUBLIC_ prefix)
CONTACT_FORM_TO_EMAIL=
RESEND_API_KEY=
